# !! REQUIRED BEFORE npm run build !!
#
# Set this to your actual deployed backend URL before building for production.
# Examples:
#   EC2 with Elastic IP:   http://ec2-xx-xx-xx-xx.compute-1.amazonaws.com:8000
#   EC2 behind ALB/HTTPS:  https://api.yourdomain.com
#   EC2 direct HTTPS:      https://your-ec2-public-dns:8000
#
# This value is baked into the static bundle at build time.
# If you change the backend URL after building, you must rebuild and redeploy.
#
# IMPORTANT: CloudFront/S3 serves HTTPS. Your backend must also be HTTPS
# (or served from the same origin) to avoid mixed-content browser errors.
# Use nginx + SSL or an Application Load Balancer on EC2 for HTTPS.

VITE_API_BASE_URL=https://REPLACE_WITH_YOUR_EC2_URL
